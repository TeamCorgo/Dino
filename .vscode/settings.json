{
    "files.exclude": {
        "**/__init__.py": true,
        "**/.venv": true,
        "**/__pycache__": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        //"**/*.code-workspace": true,
    },
    "search.exclude": {
        "**/.venv": true,
        "**/__pycache__": true,
        "**/temp": true
    },
    "editor.formatOnSave": true,
    "editor.rulers": [
        88
    ],
    "editor.fontSize": 18,
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
        }
    }
}